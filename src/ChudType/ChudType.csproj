<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF uses the process manifest before the tray WinForms component is created. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.4</Version>
    <Company>CHUDAI</Company>
    <Product>ChudType</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/chudgpt.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <Resource Include="Assets/chudgpt.png;Assets/chudgpt.ico;Assets/dictation-v1.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Audio/VoiceActivity.cs;Core/DictationModel.cs;Core/Preferences.cs;Core/TextCleanup.cs" />
    <ProjectReference Include="../ChudType.Core/ChudType.Core.csproj" />
  </ItemGroup>
</Project>
